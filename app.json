{
  "expo": {
    "name": "In Tennis Club",
    "slug": "in-tennis-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intennis",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0D0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intennisclub.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.intennisclub.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#253A2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 240,
          "backgroundColor": "#253A2B"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "O In Tennis Club usa suas fotos para a foto de perfil e para publicar seus jogos.",
          "cameraPermission": "O In Tennis Club usa a câmera para tirar fotos dos seus jogos."
        }
      ]
    ]
  }
}
